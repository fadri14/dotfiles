#!/usr/bin/env bash

sudo nix flake update --flake $HOME/.config/nixos \
&& \
chezmoi re-add $HOME/.config/nixos/flake.lock \
&& \
sudo nixos-rebuild boot --flake $HOME/.config/nixos#mynixos \
&& \
notify-send -a "NixOS" "Fin de la mise à jour" \
|| \
notify-send -a "NixOS" "ERREUR de la mise à jour"
