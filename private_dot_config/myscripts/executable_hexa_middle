#!/usr/bin/env bash

# Vérifie et convertit une couleur HEX en RGB
hex_to_rgb() {
    local hex="${1#\#}"

    if [[ ! "$hex" =~ ^[0-9A-Fa-f]{6}$ ]]; then
        echo "Erreur : couleur HEX invalide ($1)" >&2
        return 1
    fi

    echo "$((16#${hex:0:2})) $((16#${hex:2:2})) $((16#${hex:4:2}))"
}

# Calcule une couleur intermédiaire
main() {
    local color1="$1"
    local color2="$2"
    local percent=50

    read -r r1 g1 b1 <<< "$(hex_to_rgb "$color1")" || return 1
    read -r r2 g2 b2 <<< "$(hex_to_rgb "$color2")" || return 1

    if ! [[ "$percent" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
       ! awk -v p="$percent" 'BEGIN {exit !(p >= 0 && p <= 100)}'; then
        echo "Erreur : le pourcentage doit être entre 0 et 100." >&2
        return 1
    fi

    local r g b

    r=$(awk -v a="$r1" -v b="$r2" -v p="$percent" \
        'BEGIN {printf "%d", a+(b-a)*p/100+0.5}')

    g=$(awk -v a="$g1" -v b="$g2" -v p="$percent" \
        'BEGIN {printf "%d", a+(b-a)*p/100+0.5}')

    b=$(awk -v a="$b1" -v b="$b2" -v p="$percent" \
        'BEGIN {printf "%d", a+(b-a)*p/100+0.5}')

    printf "#%02X%02X%02X\n" "$r" "$g" "$b"
}

main $1 $2

